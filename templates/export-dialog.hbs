<div class="niks-app-wrapper flexcol">
  <!-- Header / Controls Bar -->
  <header class="app-toolbar">
    <div class="search-bar">
      <i class="fa-solid fa-magnifying-glass search-icon" inert></i>
      <input type="text" class="search-input" placeholder="{{localize 'niks-copy-environment.export.searchPlaceholder'}}" autocomplete="off" />
    </div>

    <div class="filter-pills">
      <button type="button" class="filter-pill active" data-action="filterStatus" data-filter="all">
        {{localize 'niks-copy-environment.filters.all'}} <span class="pill-count">{{counts.total}}</span>
      </button>
      <button type="button" class="filter-pill" data-action="filterStatus" data-filter="active">
        <i class="fa-solid fa-circle-check status-icon active" inert></i> {{localize 'niks-copy-environment.badges.active'}} <span class="pill-count">{{counts.active}}</span>
      </button>
      <button type="button" class="filter-pill" data-action="filterStatus" data-filter="inactive">
        <i class="fa-solid fa-circle-pause status-icon inactive" inert></i> {{localize 'niks-copy-environment.badges.inactive'}} <span class="pill-count">{{counts.inactive}}</span>
      </button>
      <button type="button" class="filter-pill" data-action="filterStatus" data-filter="orphaned">
        <i class="fa-solid fa-triangle-exclamation status-icon orphaned" inert></i> {{localize 'niks-copy-environment.badges.orphaned'}} <span class="pill-count">{{counts.orphaned}}</span>
      </button>
      <button type="button" class="filter-pill" data-action="filterStatus" data-filter="system">
        <i class="fa-solid fa-gear status-icon system" inert></i> {{localize 'niks-copy-environment.badges.system'}} <span class="pill-count">{{counts.system}}</span>
      </button>
      <button type="button" class="filter-pill" data-action="filterStatus" data-filter="players">
        <i class="fa-solid fa-users status-icon player" inert></i> {{localize 'niks-copy-environment.badges.players'}} <span class="pill-count">{{players.length}}</span>
      </button>
    </div>

    <div class="bulk-actions-bar">
      <div class="bulk-buttons">
        <button type="button" class="button-compact" data-action="toggleAll">
          <i class="fa-solid fa-check-double" inert></i> {{localize 'niks-copy-environment.actions.selectAll'}}
        </button>
        <button type="button" class="button-compact" data-action="toggleActiveOnly">
          <i class="fa-solid fa-filter-circle-check" inert></i> {{localize 'niks-copy-environment.actions.activeOnly'}}
        </button>
        <button type="button" class="button-compact" data-action="deselectAll">
          <i class="fa-solid fa-xmark" inert></i> {{localize 'niks-copy-environment.actions.deselectAll'}}
        </button>
      </div>
      <div class="selection-summary"></div>
    </div>
  </header>

  <!-- Scrollable Content Area -->
  <main class="app-body custom-scroll">
    <!-- Groups List -->
    {{#each groups as |group|}}
    <section class="module-card" data-type="{{group.type}}" data-id="{{group.id}}" data-title="{{group.title}}">
      <div class="module-header">
        <label class="group-select-label">
          <input type="checkbox" class="group-toggle" data-action="toggleGroup" {{#if (ne group.type 'inactive')}}checked{{/if}} />
        </label>
        <button type="button" class="collapse-toggle" data-action="toggleAccordion">
          <i class="fa-solid fa-chevron-down" inert></i>
        </button>
        <div class="module-title-wrap" data-action="toggleAccordion">
          <span class="module-title">{{group.title}}</span>
          {{#if group.version}}<span class="module-version">v{{group.version}}</span>{{/if}}
        </div>

        <div class="module-badges">
          {{#if (eq group.type 'core')}}
            <span class="badge badge-core"><i class="fa-solid fa-cube" inert></i> Core</span>
          {{else if (eq group.type 'system')}}
            <span class="badge badge-system"><i class="fa-solid fa-shield-halved" inert></i> System</span>
          {{else if (eq group.type 'active')}}
            <span class="badge badge-active"><i class="fa-solid fa-circle-check" inert></i> Active</span>
          {{else if (eq group.type 'inactive')}}
            <span class="badge badge-inactive"><i class="fa-solid fa-circle-pause" inert></i> Inactive</span>
          {{else if (eq group.type 'orphaned')}}
            <span class="badge badge-orphaned"><i class="fa-solid fa-triangle-exclamation" inert></i> Orphaned</span>
          {{/if}}
          <span class="badge badge-count">{{group.settings.length}}</span>
        </div>
      </div>

      <div class="module-settings-list">
        {{#each group.settings as |setting|}}
        <div class="setting-row" data-key="{{setting.key}}" data-name="{{setting.name}}">
          <label class="setting-item-label">
            <input type="checkbox" class="setting-checkbox" data-key="{{setting.key}}" {{#if setting.defaultSelected}}checked{{/if}} />
            <div class="setting-info">
              <span class="setting-name">{{setting.name}}</span>
              <span class="setting-key">{{setting.key}}</span>
              {{#if setting.hint}}<span class="setting-hint">{{setting.hint}}</span>{{/if}}
            </div>
          </label>
          <div class="setting-meta">
            {{#if setting.isDefault}}
              <span class="tag tag-default" title="{{localize 'niks-copy-environment.export.defaultSettingHint'}}">{{localize 'niks-copy-environment.export.defaultTag'}}</span>
            {{else}}
              <span class="tag tag-modified">{{localize 'niks-copy-environment.export.modifiedTag'}}</span>
            {{/if}}
            <span class="tag tag-scope">{{setting.scope}}</span>
          </div>
        </div>
        {{/each}}
      </div>
    </section>
    {{/each}}

    <!-- Players Card -->
    <section class="players-card" data-type="players">
      <div class="module-header">
        <label class="group-select-label">
          <input type="checkbox" class="group-toggle" data-action="toggleGroup" checked />
        </label>
        <button type="button" class="collapse-toggle" data-action="toggleAccordion">
          <i class="fa-solid fa-chevron-down" inert></i>
        </button>
        <div class="module-title-wrap" data-action="toggleAccordion">
          <span class="module-title">{{localize 'niks-copy-environment.badges.players'}}</span>
        </div>
        <div class="module-badges">
          <span class="badge badge-player"><i class="fa-solid fa-users" inert></i> Users</span>
          <span class="badge badge-count">{{players.length}}</span>
        </div>
      </div>

      <div class="players-list">
        {{#each players as |player|}}
        <div class="player-row">
          <label class="setting-item-label">
            <input type="checkbox" class="player-checkbox" data-id="{{player.id}}" checked />
            <span class="player-color-pip" style="background-color: {{player.color}};"></span>
            <div class="setting-info">
              <span class="setting-name">{{player.name}}</span>
              <span class="setting-key">{{player.roleName}}</span>
            </div>
          </label>
        </div>
        {{/each}}
      </div>
    </section>
  </main>

  <!-- Footer Actions -->
  <footer class="app-footer">
    <div class="footer-options">
      {{#if compendiumFoldersCount}}
      <label class="footer-checkbox-label">
        <input type="checkbox" id="include-compendium-folders" checked />
        <span>{{localize 'niks-copy-environment.export.includeCompendiumFolders'}} ({{compendiumFoldersCount}})</span>
      </label>
      {{/if}}
    </div>

    <div class="footer-buttons">
      <button type="button" class="button" data-action="close">
        <i class="fa-solid fa-xmark" inert></i> {{localize 'Close'}}
      </button>
      <button type="button" class="button button-primary" data-action="exportData">
        <i class="fa-solid fa-download" inert></i> {{localize 'niks-copy-environment.export.button'}}
      </button>
    </div>
  </footer>
</div>
